TP=0.2
TP_USD_PCT=20
OOR_RIGHT_CLOSE=true
TRAIL_ENABLED=false
TRAIL_ARM_PCT=1
TRAIL_DROP_PCT=0.5
OOR_MAX_MIN=0
EMERGENCY_DROP=0.2
EMERGENCY_TP_ENABLED=true
EMERGENCY_TP_TRIGGER_RANGE_PCT=50
EMERGENCY_TP_PCT=10
