# Copy to .env and chmod 600 .env. isi_ placeholders are treated as unset.
# Paper is the safe default. Strategy defaults apply when placeholders are unchanged.
# PRIVATE_KEY is optional in paper; use WALLET_PUBLIC_KEY for live preflight without exposing key.
TELEGRAM_BOT_TOKEN=isi_token_dari_botfather
TELEGRAM_CHAT_ID=isi_id_chat_telegram_kamu
TELEGRAM_ALLOWED_ID=isi_id_telegram_kamu
ALLOWED_TG_IDS=isi_nilai_allowed_tg_ids
TELEGRAM_BOT_USERNAME=isi_nilai_telegram_bot_username
SOLANA_RPC_URL=isi_url_rpc_solana
PAPER=1
DRY_RUN=1
LIVE_CONFIRMED=0
MINIAPP_HOST=isi_nilai_miniapp_host
MINIAPP_PORT=isi_nilai_miniapp_port
MINIAPP_URL=isi_url_https_miniapp_kamu
LPAGENT_ADDRESS=isi_nilai_lpagent_address
LP_BOT_DIR=isi_nilai_lp_bot_dir
LP_PAPER_DIR=isi_nilai_lp_paper_dir
LP_STOP_FILE=isi_nilai_lp_stop_file
LP_NO_NEW_FILE=isi_nilai_lp_no_new_file
LP_SECRETS_DIR=isi_nilai_lp_secrets_dir
TELEGRAM_TOKEN_FILE=isi_nilai_telegram_token_file
TELEGRAM_CFG_FILE=isi_nilai_telegram_cfg_file
TUNNEL_URL_FILE=isi_nilai_tunnel_url_file
TG_OFFSET_FILE=isi_nilai_tg_offset_file
PM2_PAPER_APP=isi_nilai_pm2_paper_app
