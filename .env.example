OPEN_SPOT_PCT=50
RESHAPE_ENABLED=true
COMPOUND_ENABLED=true
COMPOUND_SPOT_PCT=50
RESHAPE_SHAPE=BIDASK
MAX_POSITION_TVL_PCT=5
MAX_POSITIONS=10
CAPITAL_ASSET=USDC
REOPEN_COOLDOWN_MIN=30
MAX_PUMP24H_PCT=200
MAX_LIQ_USD=100000
MAX_NONREFUND_SOL=0.05
MIN_FT=0.6
