# Stale close (kosong = default: ENABLED=true, MODE=ANY|MINUS|BEP|PROFIT default ANY = tutup langsung setelah MAX_HOURS, PCT=5)
STALE_CLOSE_ENABLED=true
STALE_EXIT_MODE=ANY
STALE_EXIT_PCT=5
